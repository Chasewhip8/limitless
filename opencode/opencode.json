{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "limitless",
	"experimental": {
		"subagent_depth": 2
	},
	"permissions": [
		{
			"action": "edit",
			"resource": "*",
			"effect": "allow"
		}
	],
	"providers": {
		"openai": {
			"settings": {
				"compaction": {
					"type": "native"
				},
				"transport": "http"
			},
			"models": {
				"gpt-6-astra": {
					"limit": {
						"context": 872000,
						"input": 828400
					}
				},
				"gpt-6-astra-fast": {
					"limit": {
						"context": 872000,
						"input": 828400
					}
				}
			}
		}
	}
}
